                <characteristic name="A" typeId="a">1</characteristic>
                <characteristic name="BS" typeId="bs">4+</characteristic>
                <characteristic name="S" typeId="s">3</characteristic>
                <characteristic name="AP" typeId="ap">0</characteristic>
                <characteristic name="D" typeId="dd">1</characteristic>
                <characteristic name="Keywords" typeId="k">-</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry id="se-elder" name="Pilgrim Elder" type="model">
          <constraints>
            <constraint id="c-eld-min" type="min" value="1" field="selections" scope="parent"/>
            <constraint id="c-eld-max" type="max" value="1" field="selections" scope="parent"/>
          </constraints>
        </selectionEntry>
