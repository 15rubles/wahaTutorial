            <constraint id="c-heavy-max" type="max" value="1" field="selections" scope="parent"/>
          </constraints>
          <modifiers>
            <modifier type="increment" field="c-heavy-max" value="1">
              <repeats><repeat field="selections" scope="parent" value="10" repeats="1" childId="model" roundUp="false"/></repeats>
            </modifier>
          </modifiers>
          <selectionEntries>
            <selectionEntry id="se-cannon" name="Rust Cannon" type="upgrade">
              <costs><cost name="pts" typeId="ct-pts" value="5"/></costs>
              <profiles>
