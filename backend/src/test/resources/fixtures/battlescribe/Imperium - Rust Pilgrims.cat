                  <characteristics>
                    <characteristic name="Range" typeId="r">36"</characteristic>
                    <characteristic name="A" typeId="a">D3</characteristic>
                    <characteristic name="BS" typeId="bs">4+</characteristic>
                    <characteristic name="S" typeId="s">8</characteristic>
                    <characteristic name="AP" typeId="ap">-2</characteristic>
                    <characteristic name="D" typeId="dd">D6</characteristic>
                    <characteristic name="Keywords" typeId="k">Heavy</characteristic>
