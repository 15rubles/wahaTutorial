            <characteristic name="T" typeId="t">3</characteristic>
            <characteristic name="SV" typeId="sv">5+</characteristic>
            <characteristic name="W" typeId="w">1</characteristic>
            <characteristic name="LD" typeId="ld">7+</characteristic>
            <characteristic name="OC" typeId="oc">2</characteristic>
