# Copy to .env and fill in. Used by docker compose (never commit .env).

# Database
POSTGRES_DB=muster
POSTGRES_USER=muster
POSTGRES_PASSWORD=change-me

# First admin, created on first start when no admin exists (password: at least 10 characters)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
ADMIN_EMAIL=

# Local runs: host port of the app (http://localhost:8088)
HTTP_PORT=8088

# Session and CSRF cookies are Secure by default. Browsers accept Secure cookies on
# http://localhost; set this to false only if you test over plain http on another host.
COOKIE_SECURE=true

# Production (docker/compose.prod.yml)
# Your domain, for example muster.example.com. Caddy gets the HTTPS certificate automatically.
SITE_ADDRESS=
# Where daily database dumps go (relative to the repository root) and how long they are kept.
BACKUP_PATH=./backups
BACKUP_KEEP_DAYS=14
# Daily backup time, UTC, HH:MM
BACKUP_AT=03:15
