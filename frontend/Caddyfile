# SITE_ADDRESS ":80" (default) serves plain HTTP inside compose; a domain name such as
# "muster.example.com" makes Caddy get and renew a Let's Encrypt certificate automatically.
{
	admin off
}

{$SITE_ADDRESS::80} {
	encode zstd gzip

	log {
		output stdout
		format json
	}

	handle /healthz {
		respond "ok" 200
	}

	handle /api/* {
		reverse_proxy backend:8080 {
			header_up X-Forwarded-Proto {scheme}
		}
	}

	handle {
		root * /srv
		header {
			Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' data:; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
			X-Content-Type-Options "nosniff"
			Referrer-Policy "same-origin"
			X-Frame-Options "DENY"
			Permissions-Policy "camera=(), microphone=(), geolocation=()"
			-Server
		}
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@html not path /assets/*
		header @html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	header Strict-Transport-Security "max-age=31536000"
}
