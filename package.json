{
  "name": "battle-drill",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b && npm run build -w @battle-drill/web",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json && npm run typecheck -w @battle-drill/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "npm run dev -w @battle-drill/web",
    "lint": "eslint . && node scripts/check-dashes.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "playwright test --trace off",
    "data:sync": "tsx packages/data/src/cli.ts sync",
    "data:build": "tsx packages/data/src/cli.ts build",
    "fixtures:build": "node scripts/make-fixtures.mjs && tsx packages/data/src/cli.ts build --fixture --raw-dir fixtures/wahapedia --out-dir fixtures/normalized",
    "rules:check": "tsx scripts/check-rule-refs.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
